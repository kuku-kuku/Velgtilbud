# Supabase — get these from your project's Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Function URLs (same project ref)
VITE_SUBMIT_LEAD_URL=https://your-project-ref.supabase.co/functions/v1/submit-lead
VITE_QUOTE_API_URL=https://your-project-ref.supabase.co/functions/v1/quote-api
VITE_PARTNER_SIGNUP_URL=https://your-project-ref.supabase.co/functions/v1/partner-signup

# Cloudflare Turnstile (anti-bot). Get from https://dash.cloudflare.com > Turnstile
# Leave blank to disable the widget (submissions still require the consent checkbox).
VITE_TURNSTILE_SITE_KEY=

# Set in Supabase Edge Function secrets, NOT here:
#   supabase secrets set TURNSTILE_SECRET_KEY=your-secret
